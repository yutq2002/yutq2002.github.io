---
import { url } from "@utils/url-utils";
import { siteConfig } from "@/config";
import MainGridLayout from "../layouts/MainGridLayout.astro";
---

<MainGridLayout title="Home" description="Meet Tianqi (Theo) Yu, a Computer Science Ph.D. student at ShanghaiTech University’s SMILE Lab working on advanced implicit neural representations and generative models.">
    <div class="space-y-4">
        <section class="card-base rounded-[var(--radius-large)] px-7 py-9 md:px-10 md:py-12">
            <div data-lang-panel="en" class:list={{ hidden: siteConfig.lang !== "en" }}>
                <p class="mb-3 text-sm font-semibold tracking-wide text-[var(--primary)]">Rays, beer & AI</p>
                <h1 class="text-black/90 dark:text-white/90 mb-5 text-3xl font-bold leading-tight md:text-4xl">Hi, I'm Theo 👋</h1>
                <p class="max-w-2xl text-lg leading-relaxed text-black/75 dark:text-white/75">
                    I'm Tianqi Yu — you can call me Theo. I'm a Ph.D. student in Computer Science at
                    <a class="link text-[var(--primary)]" href="https://smilelab.com.cn" target="_blank" rel="noopener noreferrer">SMILE Lab</a>,
                    ShanghaiTech University, advised by
                    <a class="link text-[var(--primary)]" href="https://sist.shanghaitech.edu.cn/zhangyy8/main.htm" target="_blank" rel="noopener noreferrer">Prof. Yuyao Zhang</a>.
                </p>
                <p class="mt-4 max-w-2xl leading-relaxed text-black/70 dark:text-white/70">
                    My research focuses on advanced implicit neural representations, generative models,
                    and medical image reconstruction (inverse problems).
                </p>
                <p class="mt-4 max-w-2xl leading-relaxed text-black/70 dark:text-white/70">
                    Away from the lab, I'm into beer tasting and judging. I'm a judge in the
                    <a class="link text-[var(--primary)]" href="https://www.bjcp.org/" target="_blank" rel="noopener noreferrer">Beer Judge Certification Program (BJCP)</a>.
                    There is always something new to learn in both worlds.
                </p>
                <p class="mt-5 max-w-2xl font-semibold leading-relaxed text-[var(--primary)]">
                    I'm currently looking for internship and visiting research opportunities.
                </p>
                <div class="mt-8 flex flex-wrap gap-3">
                    <a class="btn-regular rounded-xl px-5 py-3 font-semibold" href={url("/cv/")}>See my CV →</a>
                    <a class="btn-plain rounded-xl px-5 py-3 font-semibold" href={url("/about/")}>A little more about me</a>
                </div>
            </div>
            <div data-lang-panel="zh_CN" class:list={{ hidden: siteConfig.lang !== "zh_CN" }}>
                <p class="mb-3 text-sm font-semibold tracking-wide text-[var(--primary)]">射线、啤酒和 AI</p>
                <h1 class="text-black/90 dark:text-white/90 mb-5 text-3xl font-bold leading-tight md:text-4xl">你好，我是于天琪（Theo）👋</h1>
                <p class="max-w-2xl text-lg leading-relaxed text-black/75 dark:text-white/75">
                    也可以叫我 Theo。我是上海科技大学
                    <a class="link text-[var(--primary)]" href="https://smilelab.com.cn" target="_blank" rel="noopener noreferrer">SMILE Lab</a>
                    的计算机科学（CS）博士生，导师是
                    <a class="link text-[var(--primary)]" href="https://sist.shanghaitech.edu.cn/zhangyy8/main.htm" target="_blank" rel="noopener noreferrer">张玉瑶（Yuyao Zhang）教授</a>。
                </p>
                <p class="mt-4 max-w-2xl leading-relaxed text-black/70 dark:text-white/70">
                    我目前主要研究先进的隐式神经表示、生成式模型，以及医学图像重建（逆问题）。
                </p>
                <p class="mt-4 max-w-2xl leading-relaxed text-black/70 dark:text-white/70">
                    实验室之外，我也喜欢品尝和评审啤酒。我是
                    <a class="link text-[var(--primary)]" href="https://www.bjcp.org/" target="_blank" rel="noopener noreferrer">啤酒裁判认证计划（Beer Judge Certification Program，BJCP）</a>的裁判。
                    科研和啤酒，总有新东西值得学习。
                </p>
                <p class="mt-5 max-w-2xl font-semibold leading-relaxed text-[var(--primary)]">
                    正在寻找实习和访问机会。
                </p>
                <div class="mt-8 flex flex-wrap gap-3">
                    <a class="btn-regular rounded-xl px-5 py-3 font-semibold" href={url("/cv/")}>查看正式简历 →</a>
                    <a class="btn-plain rounded-xl px-5 py-3 font-semibold" href={url("/about/")}>再多了解一点</a>
                </div>
            </div>
            <div class="mt-8 flex flex-wrap items-center gap-4 border-t border-black/10 pt-6 dark:border-white/10">
                <a href="https://smilelab.com.cn" target="_blank" rel="noopener noreferrer" aria-label="Visit SMILE Lab at ShanghaiTech University" class="inline-flex shrink-0 rounded-xl bg-white p-4 transition hover:-translate-y-0.5">
                    <img src={url("/images/smilelab.svg")} alt="SMILE Lab" width="861" height="269" class="h-auto w-44" />
                </a>
                <div data-lang-panel="en" class:list={{ hidden: siteConfig.lang !== "en" }}>
                    <p class="font-semibold text-black/80 dark:text-white/80">My research home</p>
                    <p class="mt-1 text-sm text-black/60 dark:text-white/60">SMILE Lab · ShanghaiTech University</p>
                </div>
                <div data-lang-panel="zh_CN" class:list={{ hidden: siteConfig.lang !== "zh_CN" }}>
                    <p class="font-semibold text-black/80 dark:text-white/80">我的科研小天地</p>
                    <p class="mt-1 text-sm text-black/60 dark:text-white/60">SMILE Lab · 上海科技大学</p>
                </div>
            </div>
        </section>

        <section class="grid gap-4 md:grid-cols-2">
            <a href={url("/activities/")} class="card-base rounded-[var(--radius-large)] p-7 transition hover:-translate-y-1">
                <div data-lang-panel="en" class:list={{ hidden: siteConfig.lang !== "en" }}>
                    <p class="mb-2 text-sm font-semibold text-[var(--primary)]">Outside the lab</p>
                    <h2 class="text-black/90 dark:text-white/90 mb-2 text-xl font-bold">What I've been up to →</h2>
                    <p class="text-black/65 dark:text-white/65">Research, events, and the occasional beer-related adventure.</p>
                </div>
                <div data-lang-panel="zh_CN" class:list={{ hidden: siteConfig.lang !== "zh_CN" }}>
                    <p class="mb-2 text-sm font-semibold text-[var(--primary)]">实验室之外</p>
                    <h2 class="text-black/90 dark:text-white/90 mb-2 text-xl font-bold">最近在忙些什么 →</h2>
                    <p class="text-black/65 dark:text-white/65">科研、活动，还有一些与啤酒有关的小冒险。</p>
                </div>
            </a>
            <a href="mailto:yutq2024@shanghaitech.edu.cn" class="card-base rounded-[var(--radius-large)] p-7 transition hover:-translate-y-1">
                <div data-lang-panel="en" class:list={{ hidden: siteConfig.lang !== "en" }}>
                    <p class="mb-2 text-sm font-semibold text-[var(--primary)]">Say hello</p>
                    <h2 class="text-black/90 dark:text-white/90 mb-2 text-xl font-bold">Let's talk →</h2>
                    <p class="text-black/65 dark:text-white/65">Ideas, collaborations, or a good beer recommendation are all welcome.</p>
                </div>
                <div data-lang-panel="zh_CN" class:list={{ hidden: siteConfig.lang !== "zh_CN" }}>
                    <p class="mb-2 text-sm font-semibold text-[var(--primary)]">保持联系</p>
                    <h2 class="text-black/90 dark:text-white/90 mb-2 text-xl font-bold">来聊聊吧 →</h2>
                    <p class="text-black/65 dark:text-white/65">研究想法、合作机会，或一款好啤酒，都欢迎来信。</p>
                </div>
            </a>
        </section>

        <section class="card-base rounded-[var(--radius-large)] p-7 md:p-9">
            <div data-lang-panel="en" class:list={{ hidden: siteConfig.lang !== "en" }}>
                <h2 class="text-black/90 dark:text-white/90 mb-2 text-xl font-bold">Where visitors come from</h2>
                <p class="mb-5 text-sm text-black/60 dark:text-white/60">Countries are counted from the day this counter was added.</p>
            </div>
            <div data-lang-panel="zh_CN" class:list={{ hidden: siteConfig.lang !== "zh_CN" }}>
                <h2 class="text-black/90 dark:text-white/90 mb-2 text-xl font-bold">访客来自哪里</h2>
                <p class="mb-5 text-sm text-black/60 dark:text-white/60">从加入统计组件之日起记录访客国家或地区。</p>
            </div>
            <a href="https://flagcounter.me/details/kKP" target="_blank" rel="noopener noreferrer" aria-label="View visitor country statistics">
                <img src="https://flagcounter.me/kKP" alt="Visitor countries and visit counts" loading="lazy" decoding="async" class="max-w-full rounded-lg" />
            </a>
            <p class="mt-3 text-xs text-black/50 dark:text-white/50">
                <span data-lang-panel="en" class:list={{ hidden: siteConfig.lang !== "en" }}>Country statistics by </span>
                <span data-lang-panel="zh_CN" class:list={{ hidden: siteConfig.lang !== "zh_CN" }}>国家或地区统计由 </span>
                <a href="https://flagcounter.me/" target="_blank" rel="noopener noreferrer" class="link">flagcounter.me</a>
                <span data-lang-panel="zh_CN" class:list={{ hidden: siteConfig.lang !== "zh_CN" }}> 提供</span>
            </p>
        </section>
    </div>
</MainGridLayout>
